includes:
  - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
  level: 6
  treatPhpDocTypesAsCertain: false
  parallel:
    maximumNumberOfProcesses: 1
  paths:
    - igniter.php
    - includes
  excludePaths:
    analyse:
      - vendor
  bootstrapFiles:
    - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
    - tests/phpstan-bootstrap.php
